{
  "schemaVersion": 1,
  "id": "io.github.xgborgeso.peripheral-batteries",
  "name": "Peripheral Batteries",
  "version": "1.1.0",
  "author": "Gabriel Borges",
  "license": "MIT",
  "description": "Wireless mice, keyboards, headsets and controllers in the Omarchy bar: presence, battery, and low-battery notifications.",
  "kinds": ["bar-widget"],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Peripheral Batteries",
    "description": "Battery and presence for wireless peripherals, grouped by brand.",
    "category": "Hardware",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "hideWhenDisconnected": true,
      "refreshIntervalSec": 30,
      "lowBatteryPercent": 20,
      "criticalBatteryPercent": 10,
      "notifyOnLow": true,
      "notifyRepeatMinutes": 0
    },
    "schema": [
      {
        "key": "hideWhenDisconnected",
        "type": "boolean",
        "label": "Hide the icon when no wireless peripheral is present",
        "defaultValue": true
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 5,
        "max": 3600,
        "step": 5,
        "defaultValue": 30
      },
      {
        "key": "lowBatteryPercent",
        "type": "integer",
        "label": "Warning battery %",
        "min": 5,
        "max": 50,
        "defaultValue": 20
      },
      {
        "key": "criticalBatteryPercent",
        "type": "integer",
        "label": "Critical battery %",
        "min": 1,
        "max": 49,
        "defaultValue": 10
      },
      {
        "key": "notifyOnLow",
        "type": "boolean",
        "label": "Notify on low battery",
        "defaultValue": true
      },
      {
        "key": "notifyRepeatMinutes",
        "type": "integer",
        "label": "Re-notify every N minutes while still low (0 = once)",
        "min": 0,
        "max": 720,
        "defaultValue": 0
      }
    ]
  }
}
